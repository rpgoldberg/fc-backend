# fc-backend secrets — DO NOT commit the real secret.yaml
#
# Generate values:
#   MONGODB_URI:        Your MongoDB connection string (local or Atlas)
#   JWT_SECRET:         openssl rand -base64 32
#   JWT_REFRESH_SECRET: openssl rand -base64 32
#   SERVICE_AUTH_TOKEN:  openssl rand -base64 32
#
# Create the secret directly with kubectl (preferred):
#   kubectl create secret generic fc-backend-secrets \
#     --namespace=figurecollecting \
#     --from-literal=MONGODB_URI='mongodb://mongodb-0.mongodb.figurecollecting.svc.cluster.local:27017/figure-collector-dev' \
#     --from-literal=JWT_SECRET="$(openssl rand -base64 32)" \
#     --from-literal=JWT_REFRESH_SECRET="$(openssl rand -base64 32)" \
#     --from-literal=SERVICE_AUTH_TOKEN="$(openssl rand -base64 32)"
#
# Or apply this file after filling in base64-encoded values:
---
apiVersion: v1
kind: Secret
metadata:
  name: fc-backend-secrets
  namespace: figurecollecting
  labels:
    app: fc-backend
    app.kubernetes.io/name: fc-backend
    app.kubernetes.io/part-of: figure-collector
type: Opaque
data:
  MONGODB_URI: <base64-encoded-mongodb-uri>
  JWT_SECRET: <base64-encoded-jwt-secret>
  JWT_REFRESH_SECRET: <base64-encoded-jwt-refresh-secret>
  SERVICE_AUTH_TOKEN: <base64-encoded-service-auth-token>
